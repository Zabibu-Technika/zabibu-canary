# zabibu canary environment — copy to .env and adjust.
# Dev defaults use a local SQLite database (zero setup).

# Signs the stateless demo tokens (our server <-> its own pages). Symmetric on
# purpose: both ends are us, so a shared secret costs nothing.
TOKEN_SECRET=dev-only-secret-change-me
DATABASE_URL=file:./data/groundtruth.db

# Approval receipts are Ed25519, not HMAC. The private key signs; the public key
# is what a verifier needs and is safe to publish. Generate a pair with:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString());console.log(publicKey.export({type:'spki',format:'pem'}).toString())"
# On hosts that take single-line values (Vercel), keep the PEM newlines as literal
# \n — the loader unescapes them.
# Leave both unset in dev: the server then signs with an ephemeral key and logs a
# warning, so a local receipt never pretends to be verifiable after a restart.
# ZABIBU_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ZABIBU_VERIFY_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Production (Supabase): configure these in your host's env settings, NOT in a
# committed .env. When DATABASE_URL is absent/not file:, the store talks to
# Supabase REST. Schema: supabase/migrations/0001_init.sql
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
